  </Reference>
  <Reference Include="Newtonsoft.Json">
    <HintPath>F:\Vintagestory\Lib\Newtonsoft.Json.dll</HintPath>
    <Private>False</Private>
  </Reference>
  <Reference Include="VintagestoryAPI">
    <HintPath>F:\Vintagestory\VintagestoryAPI.dll</HintPath>
    <Private>False</Private>
  </Reference>
  <Reference Include="VintagestoryLib">
    <HintPath>F:\Vintagestory\VintagestoryLib.dll</HintPath>
    <Private>False</Private>
  </Reference>
  <Reference Include="VSEssentials">
    <HintPath>F:\Vintagestory\Mods\VSEssentials.dll</HintPath>
    <Private>False</Private>
  </Reference>
</ItemGroup>

</Project>
